---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import { resume, formatRange } from '../lib/resume';

const { basics, interests, projects, work } = resume;
const { summary } = basics;
const current = work[0];
---

<Base title={`${basics.name}, ${basics.label}`}>
  <HeroSlider slot="hero">
    <Fragment slot="intro">
      <h1 class="name">{basics.name}</h1>
      <p class="label">{basics.label}</p>
      <ul class="btn-row links">
        <li><a class="btn btn--tonal" href="/resume">Resume</a></li>
        {
          basics.profiles.map((p) => (
            <li>
              <a class="btn btn--outlined" href={p.url} rel="me noopener">
                {p.network}
              </a>
            </li>
          ))
        }
      </ul>
    </Fragment>
  </HeroSlider>

  {
    summary && (
      <section class="section">
        <h2>About</h2>
        <div class="section-body">
          <p class="lead">{summary}</p>
        </div>
      </section>
    )
  }

  <section class="section">
    <h2>Most recently</h2>
    <div class="section-body">
      <p class="item-title">{current.position}, {current.name}</p>
      <p class="item-meta">{formatRange(current.startDate, current.endDate)}</p>
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="section">
        <h2>Side projects</h2>
        <ul class="section-body items">
          {projects.map((p) => (
            <li>
              <p class="item-title">{p.url ? <a href={p.url}>{p.name}</a> : p.name}</p>
              <p class="item-desc">{p.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    interests.length > 0 && (
      <section class="section">
        <h2>Away from the keyboard</h2>
        <ul class="section-body items">
          {interests.map((i) => (
            <li>
              <p class="item-desc">{i.url ? <a href={i.url}>{i.name}</a> : i.name}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  /* Hero intro (rendered inside HeroSlider's intro slot) */
  .name {
    font: var(--md-sys-typescale-display-small);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .label {
    margin: var(--space-2) 0 var(--space-6);
    max-width: 30rem;
    font: var(--md-sys-typescale-title-medium);
    font-weight: 400;
    color: var(--md-sys-color-on-surface-variant);
  }

  /* Sections */
  p {
    margin: 0;
  }
  .lead {
    font-size: 1.25rem;
    line-height: 2rem;
  }
  .items {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item-title {
    font: var(--md-sys-typescale-title-medium);
  }
  .item-meta {
    margin-top: var(--space-1);
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
  }
  .item-desc {
    margin-top: var(--space-1);
  }
  .items li > .item-desc:first-child {
    margin-top: 0;
  }
</style>
