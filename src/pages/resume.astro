---
import Base from '../layouts/Base.astro';
import { resume, groupByCompany, formatRange, formatDate } from '../lib/resume';

const { basics, education, skills, projects } = resume;
const companies = groupByCompany(resume.work);
---

<Base title={`Resume, ${basics.name}`}>
  <header class="head">
    <div>
      <h1>{basics.name}</h1>
      <p class="label">{basics.label}</p>
    </div>
    <button class="btn btn--tonal no-print" type="button" onclick="window.print()">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
      Save as PDF
    </button>
  </header>

  <section class="section">
    <h2>Experience</h2>
    <div class="section-body">
      {
        companies.map((c) => (
          <article class="company">
            <div class="row">
              <div>
                <h3>{c.name}</h3>
                {c.location && <p class="meta">{c.location}</p>}
              </div>
              <p class="meta dates">{formatRange(c.startDate, c.endDate)}</p>
            </div>
            {c.roles.map((r) => (
              <div class="role">
                {(c.roles.length > 1 || r.position) && (
                  <div class="row">
                    <p class="position">{r.position}</p>
                    {c.roles.length > 1 && <p class="meta dates">{formatRange(r.startDate, r.endDate)}</p>}
                  </div>
                )}
                {r.summary && <p class="meta role-summary">{r.summary}</p>}
                <ul>
                  {r.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>
            ))}
          </article>
        ))
      }
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="section">
        <h2>Projects</h2>
        <div class="section-body stack">
          {projects.map((p) => (
            <div>
              <div class="row">
                <h3>{p.url ? <a href={p.url}>{p.name}</a> : p.name}</h3>
                {p.startDate && <p class="meta dates">{formatDate(p.startDate)}</p>}
              </div>
              <p class="desc">{p.description}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    skills.length > 0 && (
      <section class="section">
        <h2>Skills</h2>
        <dl class="section-body skills">
          {skills.map((s) => (
            <>
              <dt>{s.name}</dt>
              <dd>{s.keywords.join(', ')}</dd>
            </>
          ))}
        </dl>
      </section>
    )
  }

  {
    education.length > 0 && (
      <section class="section">
        <h2>Education</h2>
        <div class="section-body stack">
          {education.map((e) => (
            <div class="row">
              <div>
                <h3>{e.institution}</h3>
                <p class="desc">
                  {e.studyType} in {e.area}
                  {e.courses?.length ? `, ${e.courses.join(', ')}` : ''}
                  {e.score && <em> ({e.score})</em>}
                </p>
              </div>
              {e.endDate && <p class="meta dates">{formatDate(e.endDate)}</p>}
            </div>
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  p {
    margin: 0;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    margin-bottom: var(--space-12);
  }
  h1 {
    font: var(--md-sys-typescale-display-small);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .label {
    margin-top: var(--space-2);
    font: var(--md-sys-typescale-title-medium);
    font-weight: 400;
    color: var(--md-sys-color-on-surface-variant);
  }
  /* Title Large section headings (global .section) sit above these Title Medium entries */
  h3 {
    font: var(--md-sys-typescale-title-medium);
  }
  .company + .company {
    margin-top: var(--space-8);
  }
  .company {
    break-inside: avoid-page;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    flex-wrap: wrap;
  }
  .meta {
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
  }
  .dates {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .role {
    margin-top: var(--space-3);
  }
  .position {
    font-style: italic;
  }
  .role-summary {
    margin-top: var(--space-1);
  }
  ul {
    margin: var(--space-2) 0 0;
    padding-left: 1.25rem;
  }
  li + li {
    margin-top: var(--space-1);
  }
  .stack {
    display: grid;
    gap: var(--space-4);
  }
  .desc {
    margin-top: var(--space-1);
  }
  .skills {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0;
  }
  .skills dt {
    font: var(--md-sys-typescale-title-small);
    padding-top: var(--space-1);
  }
  .skills dd {
    margin: 0;
  }
  /* Compact windows: stack term over definition */
  @media (max-width: 599.98px) {
    .skills {
      grid-template-columns: 1fr;
      row-gap: 0;
    }
    .skills dd + dt {
      margin-top: var(--space-3);
    }
  }
  @media print {
    .head {
      margin-bottom: var(--space-6);
    }
  }
</style>
