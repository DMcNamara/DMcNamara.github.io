---
import Base from '../layouts/Base.astro';
import { resume, groupByCompany, formatRange, formatDate } from '../lib/resume';

const { basics, education, skills, projects } = resume;
const companies = groupByCompany(resume.work);
---

<Base title={`Resume · ${basics.name}`}>
  <header class="head">
    <div>
      <h1>{basics.name}</h1>
      <p class="label">{basics.label}</p>
    </div>
    <button class="no-print print" type="button" onclick="window.print()">Save as PDF</button>
  </header>

  <section>
    <h2 class="eyebrow">Experience</h2>
    {
      companies.map((c) => (
        <article class="company">
          <div class="row">
            <h3>
              {c.name}
              {c.location && <span class="muted loc">· {c.location}</span>}
            </h3>
            <span class="dates">{formatRange(c.startDate, c.endDate)}</span>
          </div>
          {c.roles.map((r) => (
            <div class="role">
              {(c.roles.length > 1 || r.position) && (
                <div class="row">
                  <p class="position">{r.position}</p>
                  {c.roles.length > 1 && (
                    <span class="dates muted">{formatRange(r.startDate, r.endDate)}</span>
                  )}
                </div>
              )}
              {r.summary && <p class="muted role-summary">{r.summary}</p>}
              <ul>
                {r.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>
          ))}
        </article>
      ))
    }
  </section>

  {
    projects.length > 0 && (
      <section>
        <h2 class="eyebrow">Projects</h2>
        {projects.map((p) => (
          <p>
            {p.url ? <a href={p.url}>{p.name}</a> : <strong>{p.name}</strong>}
            {p.startDate && <span class="muted"> · {formatDate(p.startDate)}</span>} — {p.description}
          </p>
        ))}
      </section>
    )
  }

  {
    skills.length > 0 && (
      <section>
        <h2 class="eyebrow">Skills</h2>
        <dl class="skills">
          {skills.map((s) => (
            <>
              <dt>{s.name}</dt>
              <dd>{s.keywords.join(', ')}</dd>
            </>
          ))}
        </dl>
      </section>
    )
  }

  {
    education.length > 0 && (
      <section>
        <h2 class="eyebrow">Education</h2>
        {education.map((e) => (
          <div class="row">
            <p>
              <strong>{e.institution}</strong>
              <br />
              {e.studyType} in {e.area}
              {e.courses?.length ? `, ${e.courses.join(', ')}` : ''}
              {e.score && <em> ({e.score})</em>}
            </p>
            {e.endDate && <span class="dates">{formatDate(e.endDate)}</span>}
          </div>
        ))}
      </section>
    )
  }
</Base>

<style>
  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  h1 {
    font-size: clamp(2rem, 7vw, 2.75rem);
    margin: 0 0 0.25rem;
  }
  .label {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-ui);
  }
  .print {
    font: 500 0.9rem var(--font-ui);
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    white-space: nowrap;
  }
  .print:hover {
    border-color: var(--accent);
  }
  section + section {
    margin-top: 2.5rem;
  }
  section > .eyebrow {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.4rem;
  }
  .company {
    margin-top: 1.75rem;
    break-inside: avoid-page;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
  }
  h3 {
    font-size: 1.1rem;
    margin: 0;
  }
  .loc {
    font-weight: 400;
    font-size: 0.95rem;
  }
  .dates {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .role {
    margin-top: 0.75rem;
  }
  .position {
    margin: 0;
    font-style: italic;
  }
  .role-summary {
    margin: 0.25rem 0 0;
    font-size: 0.95rem;
  }
  ul {
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
  }
  li + li {
    margin-top: 0.3rem;
  }
  .skills {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.4rem 1rem;
    margin: 1rem 0 0;
  }
  .skills dt {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .skills dd {
    margin: 0;
  }
  @media (max-width: 34rem) {
    .skills {
      grid-template-columns: 1fr;
    }
    .skills dd {
      margin-bottom: 0.5rem;
    }
  }
</style>
