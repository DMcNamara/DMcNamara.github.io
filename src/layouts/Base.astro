---
import '../styles/global.css';
import { resume } from '../lib/resume';

interface Props {
  title: string;
  description?: string;
}

const { title, description = resume.basics.label } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'About' },
  { href: '/resume', label: 'Resume' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap"
    />
  </head>
  <body>
    <header class="site-header no-print">
      <div class="wrap bar">
        <a class="brand" href="/">{resume.basics.name}</a>
        <nav aria-label="Main">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer no-print">
      <p class="muted">© {new Date().getFullYear()} {resume.basics.name}</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    font-family: var(--font-ui);
  }
  .brand {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.95rem;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
  }
  nav a[aria-current='page'],
  nav a:hover {
    color: var(--text);
  }
  main {
    padding-block: 3rem 4rem;
  }
  .site-footer {
    border-top: 1px solid var(--rule);
    padding-block: 1.5rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
  }
</style>
